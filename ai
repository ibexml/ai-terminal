#!/bin/bash
# ai — ask Claude or ChatGPT from your terminal, on the plan you already pay for.
#   ai "question"        ask your default AI (AI_PROVIDER, default claude)
#   ai -c "question"     ask Claude   (Claude Code CLI, your Claude Pro/Max plan)
#   ai -g "question"     ask ChatGPT  (Codex CLI, your ChatGPT Plus/Pro plan)
#   ai                   type the question at a prompt;  git diff | ai  sends piped text
# Settings (environment variables):
#   AI_PROVIDER=claude|chatgpt     AI_BACKEND=auto|cli|api  (auto: plan first, else API key)
#   AI_CLAUDE_MODEL=sonnet         (CLI alias, or full model id in API mode)
#   AI_CLAUDE_EFFORT=low|medium|…  AI_CODEX_EFFORT=low      AI_OPENAI_MODEL=gpt-5
#   AI_FOLLOWUP=1 ask follow-ups (Claude)    AI_COPY=1 offer to copy the first code block
#   AI_THEME=light|dark   AI_ANIMATE=0 no animation   NO_COLOR=1 no color
set -o pipefail

PROVIDER=${AI_PROVIDER:-claude}
BACKEND=${AI_BACKEND:-auto}
case ${1:-} in
  -c) PROVIDER=claude;  shift ;;
  -g) PROVIDER=chatgpt; shift ;;
  -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
[[ $PROVIDER == openai ]] && PROVIDER=chatgpt

# ---------- look and feel (stderr only; stdout stays clean for pipes) ----------
TTY=0; [[ -t 2 ]] && TTY=1
ANIM=$TTY; [[ ${AI_ANIMATE:-1} == 0 || ${TERM:-} == dumb ]] && ANIM=0
B='' D='' R='' RED='' ACC=''
if (( TTY )) && [[ -z ${NO_COLOR:-} ]]; then
  B=$'\033[1m' D=$'\033[2m' R=$'\033[0m' RED=$'\033[31m'
  case $PROVIDER in chatgpt) ACC=$'\033[38;5;42m' ;; *) ACC=$'\033[38;5;173m' ;; esac
fi
case $PROVIDER in claude) NAME=Claude ;; chatgpt) NAME=ChatGPT ;; *) NAME=$PROVIDER ;; esac
THEME=${AI_THEME:-}   # else from COLORFGBG ("fg;bg", set by iTerm2 and others): bg 7 or 9-15 is light
[[ -z $THEME ]] && case ${COLORFGBG##*;} in 7|9|1[0-5]) THEME=light ;; *) THEME=dark ;; esac
CODE_C=36; [[ $THEME == light ]] && CODE_C=34   # code: cyan on dark, blue on light
CLR=$'\r\033[K\033[?25h'; (( ANIM )) && CLR+=$'\033]0;\007'   # clear the spinner line, show the cursor, reset the tab title

SPIN=''
spin_on() {  # animated "thinking" line with elapsed time
  (( TTY )) || return 0
  if (( ! ANIM )); then printf '%s%s is thinking…%s' "$D" "$NAME" "$R" >&2; return 0; fi
  printf '\033[?25l\033]0;ai: %s is thinking…\007' "$NAME" >&2
  ( F=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) i=0 start=$SECONDS
    while kill -0 $$ 2>/dev/null; do   # stops by itself if ai is killed
      t=$((SECONDS - start)) s=''; (( t >= 2 )) && s=" ${t}s"
      printf '\r%s%s%s %s is thinking%s%s%s\033[K' "$ACC" "${F[i++ % 10]}" "$R" "$NAME" "$D" "$s" "$R" >&2
      sleep 0.08
    done ) &
  SPIN=$!
}
spin_off() {
  (( TTY )) || return 0
  [[ -n $SPIN ]] && kill "$SPIN" 2>/dev/null; SPIN=''
  printf '%s' "$CLR" >&2
}
hdr() {  # hdr "model" — dim "Claude · sonnet" line where the spinner was (stderr)
  (( ANIM )) && printf '%s%s · %s%s\n' "$D" "$NAME" "$1" "$R" >&2
}
fail() {  # fail "what went wrong" [errfile] [how to fix]
  spin_off
  printf '%s✗%s %s\n' "$RED" "$R" "$1" >&2
  [[ -n ${3:-} ]] && printf '  %sFix:%s %s\n' "$B" "$R" "$3" >&2
  [[ -s ${2:-} ]] && { printf '%s' "$D"; tail -n 5 "$2" | sed 's/^/  /'; printf '%s' "$R"; } >&2
  exit 1
}
offer_login() {  # offer_login "Claude Code" cmd...  — ask on the tty, run the sign-in there; true if the user said yes
  local a
  (( TTY )) && [[ -r /dev/tty && -w /dev/tty ]] || return 1
  spin_off
  read -r -p "${RED}✗${R} $1 isn't signed in. Sign in now? ${D}[Y/n]${R} " a </dev/tty || return 1
  case $a in [nN]*) return 1 ;; esac
  "${@:2}" </dev/tty >/dev/tty 2>&1 || true   # its URL and prompts go to the tty, not into the render pipe
  spin_on
}

case $PROVIDER in claude|chatgpt) ;; *) fail "Unknown AI '$PROVIDER'." "" "use AI_PROVIDER=claude or chatgpt" ;; esac
case $BACKEND in auto|cli|api) ;; *) fail "Unknown AI_BACKEND '$BACKEND'." "" "use auto, cli or api" ;; esac

q="$*"
if [[ -z ${q//[[:space:]]/} && ! -t 0 ]]; then q=$(cat); fi
if [[ -z ${q//[[:space:]]/} ]]; then
  read -r -p "${ACC}›${R} Ask ${NAME}: " q </dev/tty || exit 0
fi
[[ -z ${q//[[:space:]]/} ]] && exit 0

SYS="You are answering a quick question typed in a macOS terminal. Lead with the answer, then add only what helps. Be concise, in plain text (no markdown headings). Put any shell commands on their own lines."

find_bin() {
  local c
  for c in "$(command -v "$1" 2>/dev/null)" "$HOME/.local/bin/$1" "/opt/homebrew/bin/$1" "/usr/local/bin/$1"; do
    [[ -n $c && -x $c ]] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}
get_key() {  # $1 env var, $2 keychain service
  if [[ -n ${!1:-} ]]; then printf '%s' "${!1}"
  else security find-generic-password -a "$USER" -s "$2" -w 2>/dev/null; fi
}

# Render markdown for the terminal: fences → colored code (syntax-highlighted by bat when
# installed), headings/**bold**/*italic*, bullets, links, rules; prose wrapped to the terminal
# width on word boundaries, code never; URLs clickable (OSC 8). Ends with a dim elapsed-time
# footer on stderr and, after 10 s, a terminal notification (OSC 9). UTF-8 in and out (-CS).
render() {
  if [[ ! -t 1 || -n ${NO_COLOR:-} ]]; then cat; return; fi
  AI_CODE_C=$CODE_C AI_CODE=$CODE AI_NAME=$NAME AI_FOOT=$ANIM AI_BAT=$(command -v bat 2>/dev/null) COLUMNS=$(tput cols 2>/dev/null || echo 80) perl -CS -MIPC::Open2 -MTime::HiRes=time -pe '
    BEGIN { $| = 1; $w = $ENV{COLUMNS} || 80; $bat = $ENV{AI_BAT}; $cc = $ENV{AI_CODE_C} || 36; $t0 = time }
    END { if ($ENV{AI_FOOT} && $.) { my $t = time - $t0; printf STDERR "\e[2m%.1fs\e[0m\n", $t; print STDERR "\e]9;$ENV{AI_NAME} answered\a" if $t > 10 } }
    sub cyan { $_[0] =~ s/^(.*)$/  \e[${cc}m$1\e[0m/mgr }
    sub hl {  # bat colors the block, or plain cyan when it cannot (unknown language)
      my ($code, $lang) = @_;
      my $pid = open2(my $out, my $in, "sh", "-c", q{exec "$0" "$@" 2>/dev/null}, $bat, "-l", $lang, "--style=plain", "--color=always", "--paging=never");
      binmode $in, ":utf8"; binmode $out, ":utf8";
      print $in $code; close $in; local $/; my $h = <$out>; waitpid $pid, 0;   # shortcut: block written before reading, fine below the pipe buffer (64 KB)
      ($? == 0 && length $h) ? $h =~ s/^/  /mgr : cyan($code);
    }
    sub vis { my $s = shift; $s =~ s/\e\[[\d;]*m|\e\]8;;[^\e]*\e\\//g; length $s }   # visible width, escapes dropped
    sub wrap {  # wrap at $w on spaces; continuation lines get the bullet/number indent
      my ($s, $ind) = @_; my (@o, @cur);
      for my $wd (split / /, $s, -1) {
        if (@cur && vis(join " ", @cur, $wd) >= $w) { push @o, join " ", @cur; @cur = ($ind . $wd) } else { push @cur, $wd }
      }
      push @o, join " ", @cur; join "\n", @o;
    }
    if (/^\s*```\s*(\S*)/) {
      if ($c = !$c) { $lang = $1; $code = "" }
      elsif (length $code) {
        print hl($code, $lang) if $bat && $lang;
        if ($ENV{AI_CODE} && !$saved++) { open my $f, ">:utf8", $ENV{AI_CODE}; print $f $code }   # first block, for AI_COPY
        $code = "";
      }
      $_ = ""; next;
    }
    if ($c) { $code .= $_; if ($bat && $lang) { $_ = "" } else { $_ = cyan($_) } next }
    s/^#+\s+(.*)$/\e[1m$1\e[0m/;
    s/^(\s*)[-*+]\s+/$1\x{2022} /;
    s/^\s*(?:-{3,}|\*{3,}|_{3,})\s*$/"\e[2m" . ("\x{2500}" x ($w - 2)) . "\e[0m\n"/e;
    s/\[([^]\n]+)\]\((https?:[^)\s]+)\)/$1 \e[2m$2\e[0m/g;
    s{(https?://[^\s)>\]\e]*[^\s)>\]\e.,;:!?])}{\e]8;;$1\e\\$1\e]8;;\e\\}g;
    s/`([^`\n]+)`/\e[${cc}m$1\e[0m/g;
    s/\*\*([^*\n]+)\*\*/\e[1m$1\e[0m/g;
    s/(?<![\w*])[*_](?=\S)([^*_\e\n]+?)(?<=\S)[*_](?![\w*])/\e[3m$1\e[0m/g;
    if (/\S/ && !/\x{2500}/) { chomp; my ($ind) = /^(\s*(?:\x{2022} |\d+[.)] )?)/; $_ = wrap($_, " " x length $ind) . "\n" }'
}

ERR=$(mktemp -t ai.XXXXXX)
CODE=''; [[ ${AI_COPY:-0} == 1 ]] && (( TTY )) && CODE=$(mktemp -t ai.XXXXXX)   # the answer's first code block
# AI_FOLLOWUP=1 (Claude CLI only): keep one Claude Code session for follow-up questions, deleted at exit.
SID='' TURN=0
if [[ ${AI_FOLLOWUP:-0} == 1 && $PROVIDER == claude && $BACKEND != api ]] && (( TTY )) && find_bin claude >/dev/null; then
  SID=$(uuidgen | tr '[:upper:]' '[:lower:]')
fi
cleanup() { spin_off; rm -f "$ERR" "$CODE"; [[ -n $SID ]] && rm -f "$HOME"/.claude/projects/*/"$SID".jsonl; }
trap cleanup EXIT
trap 'exit 130' INT TERM
cd "$HOME" 2>/dev/null || true   # neutral dir: no project config/hooks get loaded

# ---------- subscription CLIs ----------
# stream_text "header": print the text of a stream-json answer as it arrives; the spinner
# stops at the first word. Exits 3 when nothing was printed, with any error text appended to $ERR.
stream_text() {
  SPIN=$SPIN AI_TTY=$TTY AI_ERR=$ERR AI_HEAD=$1 AI_CLR=$CLR perl -MJSON::PP -ne '
    BEGIN { $| = 1; binmode STDOUT, ":utf8" }
    my $j = eval { decode_json($_) } or next;
    if ($j->{type} eq "stream_event") {
      my $d = $j->{event}{delta} or next; next unless ($d->{type} // "") eq "text_delta";
      if (!$n++ && $ENV{AI_TTY}) { kill TERM => $ENV{SPIN} if $ENV{SPIN}; print STDERR $ENV{AI_CLR}, $ENV{AI_HEAD} ? "$ENV{AI_HEAD}\n" : "" }
      print $d->{text};
    } elsif ($j->{type} eq "result" && $j->{is_error}) {
      open my $e, ">>", $ENV{AI_ERR}; print $e "$j->{result}\n";
    }
    END { print "\n" if $n; exit($n ? 0 : 3) }'
}
claude_cli() {
  local bin=$1 rc model=${AI_CLAUDE_MODEL:-sonnet} sess=(--no-session-persistence)
  if [[ -n $SID ]]; then if (( TURN )); then sess=(--resume "$SID"); else sess=(--session-id "$SID"); fi; fi
  printf '%s' "$q" | env -u ANTHROPIC_API_KEY "$bin" -p --verbose --output-format stream-json --include-partial-messages \
      --tools "" --strict-mcp-config "${sess[@]}" \
      --model "$model" ${AI_CLAUDE_EFFORT:+--effort "$AI_CLAUDE_EFFORT"} \
      --append-system-prompt "$SYS" 2>"$ERR" | stream_text "$(hdr "$model" 2>&1)"
  rc=("${PIPESTATUS[@]}")
  (( rc[2] == 3 )) || return 0   # the answer was printed
  if grep -qiE 'authenticat|log ?in|oauth|expired' "$ERR"; then
    [[ -z ${2:-} ]] && offer_login "Claude Code" env -u ANTHROPIC_API_KEY "$bin" auth login && { claude_cli "$bin" retried; return; }
    fail "Claude Code isn't signed in." "$ERR" "$bin auth login"
  elif (( rc[1] )); then fail "Claude Code couldn't answer." "$ERR"
  else fail "Claude Code sent an empty reply." "$ERR"; fi
}
codex_cli() {
  local bin=$1 out
  out=$(env -u OPENAI_API_KEY "$bin" exec --skip-git-repo-check --ephemeral \
          -c "model_reasoning_effort=\"${AI_CODEX_EFFORT:-low}\"" \
          -- "$SYS Do not run commands or read files unless the question needs it.

Question: $q" </dev/null 2>"$ERR") \
    || { [[ -n $out ]] && printf '%s\n' "$out" >>"$ERR"
         [[ -z ${2:-} && ! -f $HOME/.codex/auth.json ]] && offer_login Codex env -u OPENAI_API_KEY "$bin" login && { codex_cli "$bin" retried; return; }
         fail "Codex couldn't answer (not signed in?)." "$ERR" "$bin login"; }
  [[ -n $out ]] || fail "Codex sent an empty reply." "$ERR"
  spin_off; hdr codex
  printf '%s\n' "$out"
}

# ---------- API-key fallback ----------
api_reply() {  # api_reply "$response_json" 'jq filter for the answer text' "model"
  local msg out
  msg=$(printf '%s' "$1" | jq -r '.error.message? // empty' 2>/dev/null)
  [[ -n $msg ]] && fail "The API said: $msg"
  out=$(printf '%s' "$1" | jq -r "$2" 2>/dev/null)
  [[ -n $out && $out != null ]] || fail "The API sent an empty or unreadable reply."
  spin_off; hdr "$3"
  printf '%s\n' "$out"
}
claude_api() {
  local key=$1 body resp
  command -v jq >/dev/null || fail "API mode needs jq." "" "brew install jq"
  local model=${AI_CLAUDE_MODEL:-claude-sonnet-5-5}; [[ $model == sonnet ]] && model=claude-sonnet-5-5
  # the prompt and the key never go on a command line, where any local user could read them with ps
  body=$(Q=$q S=$SYS jq -n --arg m "$model" \
    '{model:$m, max_tokens:2048, system:env.S, messages:[{role:"user", content:env.Q}]}')
  resp=$(printf '%s' "$body" | curl -sS --connect-timeout 10 --max-time 300 https://api.anthropic.com/v1/messages \
      -H @<(printf 'x-api-key: %s\n' "$key") -H "anthropic-version: 2023-06-01" \
      -H "content-type: application/json" --data-binary @- 2>"$ERR") \
    || fail "Couldn't reach Anthropic." "$ERR" "check your internet connection"
  api_reply "$resp" '[.content[]? | select(.type=="text") | .text] | join("")' "$model"
}
openai_api() {
  local key=$1 body resp
  command -v jq >/dev/null || fail "API mode needs jq." "" "brew install jq"
  local model=${AI_OPENAI_MODEL:-gpt-5}
  body=$(Q=$q S=$SYS jq -n --arg m "$model" \
    '{model:$m, messages:[{role:"system", content:env.S}, {role:"user", content:env.Q}]}')
  resp=$(printf '%s' "$body" | curl -sS --connect-timeout 10 --max-time 300 https://api.openai.com/v1/chat/completions \
      -H @<(printf 'Authorization: Bearer %s\n' "$key") -H "content-type: application/json" --data-binary @- 2>"$ERR") \
    || fail "Couldn't reach OpenAI." "$ERR" "check your internet connection"
  api_reply "$resp" '.choices[0].message.content' "$model"
}

offer_copy() {  # AI_COPY=1: Enter copies the answer's first code block to the clipboard
  local k; [[ -s $CODE ]] || return 0
  read -r -s -n1 -p "${D}↵ copy the first code block · any other key to skip${R}" k </dev/tty || k=skip
  printf '\r\033[K' >&2
  [[ -z $k ]] && pbcopy <"$CODE" && printf '%s✓ copied%s\n' "$D" "$R" >&2
  : >"$CODE"
}

# ---------- dispatch ----------
while :; do
spin_on
{ case $PROVIDER in
  claude)
    if [[ $BACKEND != api ]] && bin=$(find_bin claude); then claude_cli "$bin"
    elif [[ $BACKEND != cli ]] && key=$(get_key ANTHROPIC_API_KEY ai-zsh-anthropic) && [[ -n $key ]]; then claude_api "$key"
    elif [[ $BACKEND == api ]]; then fail "No Anthropic API key found." "" "set ANTHROPIC_API_KEY, or rerun the installer to save one"
    else fail "Claude Code isn't installed." "" "curl -fsSL https://claude.ai/install.sh | bash   (or rerun the installer)"; fi ;;
  chatgpt)
    if [[ $BACKEND != api ]] && bin=$(find_bin codex); then codex_cli "$bin"
    elif [[ $BACKEND != cli ]] && key=$(get_key OPENAI_API_KEY ai-zsh-openai) && [[ -n $key ]]; then openai_api "$key"
    elif [[ $BACKEND == api ]]; then fail "No OpenAI API key found." "" "set OPENAI_API_KEY, or rerun the installer to save one"
    else fail "Codex isn't installed." "" "brew install --cask codex   (or rerun the installer)"; fi ;;
esac; } | render || exit $?
[[ -n $CODE ]] && offer_copy
[[ -n $SID ]] || break
read -r -p "${ACC}›${R} Follow-up ${D}(Enter to quit)${R}: " q </dev/tty || break
[[ -z ${q//[[:space:]]/} ]] && break
TURN=$((TURN + 1))
done
